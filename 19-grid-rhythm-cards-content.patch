diff --git a/src/styles/globals.css b/src/styles/globals.css
index 0000000..0000000 100644
--- a/src/styles/globals.css
+++ b/src/styles/globals.css
@@ -649,4 +649,45 @@
   .blog-grid-item-small {
     grid-column: span 4 / span 4;
   }
+  .blog-grid-item-trio {
+    grid-column: span 4 / span 4;
+  }
+}
+
+/* Blog card image heights — hand-authored, same reasoning as .blog-grid
+   above: these are the two most likely candidates for the same "brand new
+   utility value, not used anywhere else" JIT miss, so writing them as plain
+   CSS avoids the risk entirely rather than trusting Tailwind's scanner
+   again. "large" and "small" share a height so a wide 8-col card and a
+   narrow 4-col card next to it read as a matched pair; "trio" is shorter,
+   for the row of three equal-width cards below that. */
+.blog-card-img {
+  position: relative;
+  width: 100%;
+  overflow: hidden;
+}
+.blog-card-img-large,
+.blog-card-img-small {
+  height: 220px;
+}
+.blog-card-img-trio {
+  height: 200px;
+}
+@media (min-width: 768px) {
+  .blog-card-img-large,
+  .blog-card-img-small {
+    height: 320px;
+  }
+  .blog-card-img-trio {
+    height: 240px;
+  }
+}
+@media (min-width: 1024px) {
+  .blog-card-img-large,
+  .blog-card-img-small {
+    height: 380px;
+  }
+  .blog-card-img-trio {
+    height: 260px;
+  }
 }
