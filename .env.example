# ---------------------------------------------------------------------------
# Google Ads conversion tracking (landing pages)
# ---------------------------------------------------------------------------
# The Google Ads account/tag ID. Format: AW- followed by 9-11 digits.
# The landing layout refuses to render the gtag script unless this is a real,
# well-formed value — the AW-XXXXXXXXX placeholder will NOT ship a tag.
NEXT_PUBLIC_GADS_ID=AW-000000000

# The full "send_to" conversion label for a lead: the account ID, a slash, and
# the conversion-action label. Used as the send_to value for the lead conversion.
NEXT_PUBLIC_GADS_LABEL_LEAD=AW-000000000/AbCdEfGhIjKlMnOp

# ---------------------------------------------------------------------------
# Google Sheets lead sink (server-side only — never expose to the client)
# ---------------------------------------------------------------------------
# The ID of the Google Sheet leads are appended to (from the sheet URL).
GOOGLE_SHEET_ID=

# The service account email with edit access to the sheet.
GOOGLE_SERVICE_ACCOUNT_EMAIL=

# The service account private key. Keep the literal \n escapes on one line,
# wrapped in quotes.
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ---------------------------------------------------------------------------
# Booking engine — Supabase
# ---------------------------------------------------------------------------
# Point these at the SAME Supabase project madhuban-web uses. Invoice serial
# numbers are legally sequential per financial year, so a second database would
# start re-issuing numbers that already exist.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key: bypasses RLS. Server-side only — never prefix NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Booking engine — Razorpay
# ---------------------------------------------------------------------------
# Use rzp_test_* keys on Preview. A live key in Preview takes real money.
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Set in the Razorpay dashboard when registering the webhook. This is a
# different secret from RAZORPAY_KEY_SECRET.
RAZORPAY_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Booking engine — Resend (transactional email)
# ---------------------------------------------------------------------------
RESEND_API_KEY=
# Must be a sender on a domain verified in Resend.
RESEND_FROM_EMAIL=

# Optional. Redirects EVERY outgoing mail to this address instead of the guest.
# Set it on Preview and Development so test bookings cannot email real guests.
#
# MUST NOT be set on Production. Left there it swallows every guest confirmation
# and every staff booking notification and posts them to a test inbox — which is
# what it was doing. lib/resend/index.js now ignores it whenever
# VERCEL_ENV === "production" and logs a warning, but delete it from the
# Production environment in Vercel anyway rather than relying on that guard.
RESEND_DEV_OVERRIDE_TO=

# ---------------------------------------------------------------------------
# Booking engine — Upstash (rate limiting)
# ---------------------------------------------------------------------------
# Optional: if unset, rate limiting logs a warning and no-ops. Set in production.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ---------------------------------------------------------------------------
# Booking engine — admin auth & misc
# ---------------------------------------------------------------------------
# Fallback super-admin: allowed into /admin even without a user_profiles row,
# and the recipient_email stamped on in-app notification rows. Changing it locks
# that bootstrap account out and hides existing notifications, so treat it as an
# identity rather than a mailing list.
#
# Booking notifications do NOT depend on this. They always go to the property
# inbox in src/lib/content/business.js (madhubanresort@somaiya.com); anything
# listed here — comma-separated — is CC'd on top.
ADMIN_EMAIL=

# Bearer token guarding POST /api/cron/send-reminders.
CRON_SECRET=

# Absolute base URL used in emails, invoices and Razorpay callbacks.
NEXT_PUBLIC_SITE_URL=https://www.madhubanecoretreat.com

# ---------------------------------------------------------------------------
# Cloudflare R2 — booking layout logo and blog CMS images
# ---------------------------------------------------------------------------
# Public base for objects in the bucket, e.g. https://pub-<id>.r2.dev. Whatever
# host this resolves to must also be listed in next.config.mjs under
# images.remotePatterns, or next/image rejects every blog image.
NEXT_PUBLIC_R2_BASE=

# S3-compatible endpoint. Both the full URL
# (https://<account>.r2.cloudflarestorage.com) and the bare 32-character account
# id are accepted; this project stores the full URL.
R2_ACCOUNT_ID=

# S3 API token for the bucket (Cloudflare dashboard → R2 → Manage API tokens),
# with object read and write. Server-side only — never prefix NEXT_PUBLIC_.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Bucket that blog images are written to, under a blog/ prefix.
R2_BUCKET_NAME=
