# ---------------------------------------------------------------------------
# Google Ads conversion tracking (landing pages)
# ---------------------------------------------------------------------------
# The Google Ads account/tag ID. Format: AW- followed by 9-11 digits.
# The landing layout refuses to render the gtag script unless this is a real,
# well-formed value — the AW-XXXXXXXXX placeholder will NOT ship a tag.
NEXT_PUBLIC_GADS_ID=AW-000000000

# The full "send_to" conversion label for a lead: the account ID, a slash, and
# the conversion-action label. Used as the send_to value for the lead conversion.
NEXT_PUBLIC_GADS_LABEL_LEAD=AW-000000000/AbCdEfGhIjKlMnOp

# ---------------------------------------------------------------------------
# Google Sheets lead sink (server-side only — never expose to the client)
# ---------------------------------------------------------------------------
# The ID of the Google Sheet leads are appended to (from the sheet URL).
GOOGLE_SHEET_ID=

# The service account email with edit access to the sheet.
GOOGLE_SERVICE_ACCOUNT_EMAIL=

# The service account private key. Keep the literal \n escapes on one line,
# wrapped in quotes.
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
