+/* Admin blog editor — links inside the TipTap editing area default to
+   browser blue since neither the browser default nor Tailwind Typography's
+   own default link color matches the brand. .ProseMirror is the class
+   TipTap itself puts on the editable content root, so this reaches every
+   link typed or pasted into the editor regardless of how it was created. */
+.ProseMirror a {
+  color: var(--color-brand-bronze) !important;
+  text-decoration: none;
+}
+.ProseMirror a:hover {
+  color: var(--color-earth-brown) !important;
+}
