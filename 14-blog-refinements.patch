+
+/**
+ * Author bio card. Used after the FAQs on an article page (where the writer
+ * is a footnote, not the headline) and at the top of the author's own
+ * archive page — same visual language in both places.
+ */
+export default function AuthorBio({ author, headingLevel = "h2" }) {
+  if (!author) return null;
+  const HeadingTag = headingLevel;
+
+  return (
+    <div className="flex flex-col sm:flex-row items-center sm:items-start gap-5 bg-white rounded-xl p-6 md:p-8 border border-earth-brown/10 max-w-3xl mx-auto">
