+        <Image
+          src={author.avatar_url || FALLBACK_AVATAR}
+          alt={author.avatar_alt || author.name}
+          fill
+          sizes="96px"
+          className="object-cover"
+        />
+      </div>
+      <div className="text-center sm:text-left">
+        <p className="text-xs text-charcoal/45 uppercase tracking-wide mb-1">
+          Written by
+        </p>
